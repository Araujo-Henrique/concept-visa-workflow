# Variáveis de PRODUÇÃO (docker compose --env-file .env.prod ...). Copie para .env.prod NA VPS e preencha.
# Este arquivo (.env.prod) nunca vai para o Git.

# Domínio do sistema (o DNS precisa apontar para o IP da VPS, e as portas 80/443 abertas)
DOMINIO=vistos.exemplo.com.br

# Banco. Use só letras e números na senha (ela entra numa URL). Gere com: openssl rand -hex 24
POSTGRES_USER=concept
POSTGRES_PASSWORD=
POSTGRES_DB=concept_visa_workflow

# Assinatura dos tokens (obrigatório; a API não sobe com valor fraco). Gere com: openssl rand -hex 32
JWT_SECRET=

# Login com o Google (opcional). No Google Cloud, o URI de redirecionamento é o do seu domínio (veja docs/DEPLOY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
