# Banco da aplicação (URL-encode caracteres especiais na senha: @ vira %40)
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/concept_visa_workflow

# Banco só de testes: o nome precisa terminar em _test
TEST_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/concept_visa_workflow_test

# Autenticação (etapa 5)
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=

# Importação do banco do Projeto 1 (scripts/importar_projeto1.py)
SOURCE_DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/concept_client_registry

# Duração do token de acesso, em minutos (padrão 30)
JWT_EXPIRA_MINUTOS=30

# Teto da sessão, em horas desde o login (padrão 10): renovando pelo uso, ninguém passa disso sem entrar de novo
JWT_SESSAO_MAXIMA_HORAS=10

# Proteções contra abuso (padrões entre parênteses; veja "Proteções contra abuso" no README)
LIMITE_LOGIN_POR_MINUTO=10            # tentativas de login por IP (10)
LIMITE_FALHAS_DE_SENHA=5              # senhas erradas por conta em 15 minutos antes de travar (5)
LIMITE_REQUISICOES_POR_MINUTO=600     # requisições por IP, em qualquer rota (600)
LIMITE_CORPO_KB=1024                  # tamanho máximo do corpo da requisição (1024)
API_PROXIES_CONFIAVEIS=127.0.0.1,::1  # de onde a API aceita o X-Cliente-IP (o servidor do Next)
API_DOCS=true                         # false em produção: tira o /docs e o /openapi.json

# Banco: tempo máximo por consulta e tamanho do pool de conexões
DB_TEMPO_MAXIMO_CONSULTA_MS=15000
DB_POOL=5
DB_POOL_EXTRA=5
DB_ESPERA_CONEXAO=10

# Logs: nivel (DEBUG, INFO, WARNING, ERROR) e formato (texto para o terminal, json para ferramentas)
LOG_NIVEL=INFO
LOG_FORMATO=texto
LOG_ARQUIVO=logs/api.log             # vazio = so terminal; com rotacao
LOG_ARQUIVO_MB=5                     # tamanho de cada arquivo
LOG_ARQUIVO_COPIAS=5                 # quantos arquivos antigos guardar (o mais velho e apagado)
IDEMPOTENCIA_ESPERA_SEGUNDOS=10      # quanto um reenvio espera o pedido original terminar
