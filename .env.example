# Banco da aplicação (URL-encode caracteres especiais na senha: @ vira %40)
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/concept_visa_workflow

# Banco só de testes: o nome precisa terminar em _test
TEST_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/concept_visa_workflow_test

# Autenticação (etapa 5)
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=

# Importação do banco do Projeto 1 (scripts/importar_projeto1.py)
SOURCE_DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/concept_client_registry

# Duração do token de acesso, em minutos (padrão 30)
JWT_EXPIRA_MINUTOS=30
